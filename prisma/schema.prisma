// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String
  isAdmin       Boolean        @default(false)
  /// Set when an admin issues the account with a temporary password. The app
  /// blocks the interface with a non-dismissible prompt until the person picks
  /// their own, because until then whoever created the account knows it.
  mustChangePassword Boolean   @default(false)
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  usageEvents   UsageEvent[]
  files         GeneratedFile[]
}

/// One row per completed model call, so per-user token totals survive the user
/// deleting their conversations (deliberately NOT hung off Conversation).
model UsageEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New chat")
  model     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  files     GeneratedFile[]

  @@index([userId, updatedAt])
}

/// A spreadsheet or document the assistant produced. The bytes live here
/// because there is no object storage in this deployment, and a download link
/// in an old conversation has to keep working — regenerating the file later
/// would cost another model call and wouldn't be byte-identical anyway.
model GeneratedFile {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  filename       String
  mediaType      String
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  // Image attachments (data: URLs), shaped like the AI SDK's FileUIPart[].
  // Stored so images survive reopening a conversation, not just the live session.
  attachments    Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
