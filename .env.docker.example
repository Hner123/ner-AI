# ============================================================
# NerKyot — production environment (chat.heineraboka.site)
#
# Copy to `.env.docker` on the server and fill in real values.
# This one file is read by BOTH the app and the Postgres container.
# Never commit it — it is gitignored and excluded from the Docker build
# context, so these secrets never end up inside an image layer.
# ============================================================

# --- Database ---
# The password is the only secret here; user/db names are fixed by convention
# (docker-compose.yml's healthcheck expects ner_ai/ner_ai).
POSTGRES_USER=ner_ai
POSTGRES_DB=ner_ai
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password

# Must contain the same password as POSTGRES_PASSWORD above. "postgres" is the
# compose service name — inside the Docker network that resolves to the DB.
DATABASE_URL="postgresql://ner_ai:CHANGE_ME_generate_a_long_random_password@postgres:5432/ner_ai"

# --- Auth ---
# Signs session cookies. Generate a FRESH one for production — never reuse the
# development value. Anyone holding this can forge a login for any account.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=CHANGE_ME_generate_a_fresh_secret

# The app's own public URL. Behind a reverse proxy the container only ever
# sees a request for localhost:3000, so without this Auth.js builds absolute
# URLs against that — and anything it redirects (signing out, for one) sends
# the browser to an address that doesn't exist on a phone. No trailing slash.
AUTH_URL="https://chat.heineraboka.site"

# --- Android app (optional — see ANDROID.md) ---
# Published at /.well-known/assetlinks.json to prove the Android app and this
# site are the same product. Without them the app still runs, but Chrome keeps
# a URL bar pinned above it. The fingerprint is printed by the Build Android
# app workflow; several can be listed, comma-separated.
# ANDROID_PACKAGE_NAME=site.heineraboka.chat
# ANDROID_CERT_FINGERPRINT="AB:CD:..."

# --- Tooken-Pool gateway ---
# A gds_live_... virtual key from the gateway dashboard. Every signed-in user's
# requests are proxied through this one key, so its budget and rate limits are
# shared across everyone with an account here.
GDS_GATEWAY_URL="https://ai-gateway.heineraboka.site"
GDS_GATEWAY_KEY="gds_live_..."

# Models offered in the picker. Must all be in that key's model_whitelist on
# the gateway, or selecting one returns 403. First entry is the default.
ALLOWED_MODELS="gpt-5.6-terra, claude-sonnet-4-5, gpt-5.6-sol, gpt-5.6-luna, gpt-5.5"
