# ============================================================
# NerKyot — environment configuration
# For `npm run dev`: copy to `.env`. For `docker compose`: copy to
# `.env.docker` instead (same values, except DATABASE_URL — see below).
# Never commit either file.
# ============================================================

# --- Database (Postgres) ---
# A separate database from the Tooken-Pool gateway's own Postgres — this app
# owns its own users/conversations/messages, unrelated to the gateway's
# client_keys/usage_logs schema.
#
# npm run dev:      whatever Postgres you're running locally, e.g. the
#                   Prisma-managed one from `npx prisma dev`.
# docker compose:   postgresql://ner_ai:ner_ai@postgres:5432/ner_ai
#                   ("postgres" = the compose service name, not localhost).
DATABASE_URL="postgresql://user:password@localhost:5432/ner_ai"

# --- Auth (Auth.js / NextAuth v5) ---
# Session-signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The app's own public URL. Only needed when it runs behind a reverse proxy:
# the container sees requests for localhost:3000 and would otherwise build
# absolute redirect URLs against that. Leave unset for `npm run dev`.
#   AUTH_URL="https://chat.example.com"

# --- Tooken-Pool gateway ---
# Base URL of your deployed GDS AI Gateway (no trailing /v1 — that's added
# automatically), and a gds_live_... virtual key created in its dashboard.
# This key is shared by every signed-in user of this app — see README.md.
GDS_GATEWAY_URL="https://ai-gateway.example.com"
GDS_GATEWAY_KEY="gds_live_..."

# Comma-separated model ids offered in the UI's model picker. MUST be a
# subset of the gds_live_ key's model_whitelist on the gateway, or requests
# for that model 403.
ALLOWED_MODELS="gpt-4.1-mini,claude-sonnet-4-5"

# --- Accounts ---
# There is no public signup. Create accounts with:
#   npm run create-user -- someone@example.com "a-real-password" "Their Name"
#   docker compose exec ner-ai npm run create-user -- someone@example.com "a-real-password"
